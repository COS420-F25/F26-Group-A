---
const { title = "StudyBuddies" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Keep in sync with `light` in react-componenets/lightUi.js */
      :root {
        --sb-bg: #ffffff;
        --sb-sidebar: #f7f8fa;
        --sb-border: #e3e5e8;
        --sb-text: #111827;
        --sb-accent: #2848c9;
        --sb-accent-hover: #1f3aa8;
        --sb-accent-soft: #e6ebfb;
      }

      html,
      body {
        margin: 0;
        background: var(--sb-bg);
        color: var(--sb-text);
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto,
          Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* Visible keyboard focus everywhere */
      a:focus-visible,
      button:focus-visible,
      summary:focus-visible,
      [role="link"]:focus-visible {
        outline: 2px solid var(--sb-accent);
        outline-offset: 2px;
      }

      .sb-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* ---------- Login ---------- */
      .sb-choices {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .sb-choice:hover {
        border-color: var(--sb-accent) !important;
        background: var(--sb-accent-soft) !important;
      }
      .sb-input:focus {
        outline: 2px solid var(--sb-accent);
        outline-offset: 1px;
        border-color: var(--sb-accent) !important;
      }
      .sb-segment:has(input:checked) {
        border-color: var(--sb-accent) !important;
        background: var(--sb-accent-soft) !important;
        color: var(--sb-accent) !important;
      }
      .sb-segment:has(input:focus-visible) {
        outline: 2px solid var(--sb-accent);
        outline-offset: 2px;
      }
      .sb-submit:hover {
        background: var(--sb-accent-hover) !important;
      }
      .sb-google:hover {
        background: var(--sb-sidebar) !important;
      }

      /* ---------- Instructor shell ---------- */
      .sb-shell {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        min-height: 100vh;
      }
      .sb-sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 20px 14px;
        box-sizing: border-box;
        background: var(--sb-sidebar);
        border-right: 1px solid var(--sb-border);
      }
      .sb-nav,
      .sb-sidebar-bottom {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .sb-sidebar-bottom {
        margin-top: auto;
      }
      .sb-main {
        padding: 48px 64px;
      }
      .sb-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 48px;
        align-items: center;
      }
      .sb-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }
      .sb-btn-primary:hover {
        filter: brightness(1.1);
      }
      .sb-faq summary {
        list-style: none;
      }
      .sb-faq summary::-webkit-details-marker {
        display: none;
      }

      @media (max-width: 900px) {
        .sb-hero {
          grid-template-columns: 1fr;
        }
      }

      /* Sidebar becomes a top bar */
      @media (max-width: 768px) {
        .sb-shell {
          grid-template-columns: 1fr;
        }
        .sb-sidebar {
          position: static;
          height: auto;
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
          gap: 8px 12px;
          padding: 12px 16px;
          border-right: none;
          border-bottom: 1px solid var(--sb-border);
        }
        .sb-course,
        .sb-user-text {
          display: none;
        }
        .sb-nav,
        .sb-sidebar-bottom {
          flex-direction: row;
          flex-wrap: wrap;
          align-items: center;
        }
        .sb-nav {
          order: 3;
          width: 100%;
        }
        .sb-sidebar-bottom {
          margin-top: 0;
          margin-left: auto;
        }
        .sb-main {
          padding: 28px 20px 48px;
        }
      }

      @media (max-width: 700px) {
        .sb-steps {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 600px) {
        .sb-choices {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>