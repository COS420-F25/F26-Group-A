{
  "name": "studdybuddies",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "host": "astro dev --host",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "firebase": "^9.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs@7.6.6": true,
    "protobufjs@6.11.6": true,
    "@parcel/watcher@2.6.0": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-components/(.*)$": "<rootDir>/src/react-components/$1",
      "^@authent/(.*)$": "<rootDir>/src/react-components/authent/$1",
      "^@groups/(.*)$": "<rootDir>/src/react-components/groups/$1",
      "^@survey/(.*)$": "<rootDir>/src/react-components/survey/$1",
      "^@utils/(.*)$": "<rootDir>/src/react-components/utils/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/react-components/setup.js"
    ],
    "collectCoverageFrom": [
      "src/react-components/**/*.{js,jsx}",
      "!src/react-components/__tests__/**",
      "!src/react-components/setup.js"
    ],
    "coverageReporters": [
      "text",
      "html"
    ]
  }
}
